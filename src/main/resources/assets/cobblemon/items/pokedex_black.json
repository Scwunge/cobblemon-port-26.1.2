{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui",
          "fixed"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "cobblemon:item/pokedex_black"
        }
      },
      {
        "when": [
          "ground",
          "head",
          "none"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "cobblemon:item/pokedex_black_model_off"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_true": {
        "type": "minecraft:model",
        "model": "cobblemon:item/pokedex_black_model_scanning"
      },
      "on_false": {
        "type": "minecraft:model",
        "model": "cobblemon:item/pokedex_black_model"
      }
    }
  }
}
